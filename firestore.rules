rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registrations collection: allow any applicant to create a registration, allow reading
    match /registrations/{registrationId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.whatsappNumber is string;
      allow read, update, delete: if true;
    }

    // Config collection for admin sheets settings
    match /config/{configId} {
      allow read, write: if true;
    }

    // Fallback rule for other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
